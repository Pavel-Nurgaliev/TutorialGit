Private Sub UbsChnlAsync_Respond(Index As Integer, ByVal LastRespond As Boolean, OutParams As Object)
    Dim FileNameServer As String
    Dim nPos As Long
    Dim bIsOk As Boolean
    Dim i
    
    On Error GoTo ErrorCode
    
    If OutParams.ExistParameter("ReportError") Then
        ' на случай глобальных ошибок
        MsgBox OutParams.Parameter("ReportError"), vbCritical, "Ошибка!"
        cmdExit.Caption = "Выход"
        lblChannelInfo(Index).BackColor = Go.BackColor
        Call SetButtonGoAndcmdExit("Загрузка!", True)
    Else
        FileNameServer = OutParams.Parameter("Имя файла")
        nPos = InStrRev(FileNameServer, "\")
        If nPos <> 0 Then arrFileNameServer(Index) = Right(FileNameServer, Len(FileNameServer) - nPos) Else arrFileNameServer(Index) = FileNameServer
        lblChannelInfo(Index).BackColor = RGB(255, 255, 255)
    End If
    UbsChnlAsync(Index).Tag = ""

    bIsOk = True
    For i = 0 To UbsChnlAsync.UBound()
        If UbsChnlAsync(i).Tag <> "" Then bIsOk = False
    Next

    If bIsOk Then
        DoAsincReport
    
        Call SetButtonGoAndcmdExit("Загрузка!", True)
        For i = 0 To lblChannelInfo().UBound
            lblChannelInfo(i).BackColor = Go.BackColor
        Next
        cmdExit.Caption = "Выход"
    
        blnRespond = False
    End If

    Exit Sub

ErrorCode:
    ToolErr.UbsErrMsg "UbsChnlAsync_Respond", "ошибка выполнения"
End Sub

Private Sub DoAsincReport()
    Dim ClientFileName As String, ClientFileNameTmp As String
    Dim objFile As Object
    Dim i
    
    On Error GoTo ErrCode
    
    UbsChannel.NumFrame = 0
    UbsChannel.LoadResource = "VBS:UBS_VBS\PLCARD\Processing\PCPRCFile.vbs"
    
    ' Запись о загруженном файле в состояние "Обработан"
    objInParam.Parameter("IdFile") = IdFile
    objInParam.Parameter("State") = 0
    Call UbsChannel.Run("PCPRCFile_SetStateParam", objInParam, objOutParam)

    For i = 0 To UBound(arrFileNameServer, 1)
        If Trim(arrFileNameServer(i)) <> "" Then
            If ClientFileName = "" Then
                ' Создаем один файл на клиенте(итоговый)
                ClientFileName = UbsFile.GetTempFile
                If Not UbsFile.OpenTextFile(ClientFileName, False) Then
                    MsgBox "Файл-протокол " & ClientFileName & " не открыт на запись", vbCritical, "Ошибка!"
                    Exit Sub
                End If
            End If
                
            ' Получаем имя временного файла
            ClientFileNameTmp = UbsFile.GetTempFile
            UbsFile.DeleteFile ClientFileNameTmp
            ' копируем на клиент файл-отчет канала i
            UbsChannel.GetFile ClientFileNameTmp, "Temp", arrFileNameServer(i)
            ' удаляем файл-отчет канала i с сервера
            objInParam.Parameter("VirtualFolder") = "Temp"
            objInParam.Parameter("ServerFile") = arrFileNameServer(i)
            UbsChannel.Run "DeleteServerFileExStub", objInParam, objOutParam
            ' пишу в итоговый файл протокол импорта
            If strImportReport <> "" Then
                UbsFile.WriteLine strImportReport
                strImportReport = ""
            End If
            ' пишу в итоговый протокол канала i
            If objFile Is Nothing Then Set objFile = CreateObject("Lib1.IUbsFile")
            UbsFile.WriteLine objFile.ReadAll(ClientFileNameTmp)
            UbsFile.DeleteFile ClientFileNameTmp
        End If
    Next
   
    ' Если была запись в файл ...
    If ClientFileName <> "" Then
        UbsFile.CloseFile
    
        Set WaitBox = CreateObject("UbsWait.UbsWaitBox")
        WaitBox.FileName = ClientFileName
        WaitBox.MaximizeView
        WaitBox.ViewFile
        Set WaitBox = Nothing
     
        UbsFile.DeleteFile ClientFileName
    End If
    
    Exit Sub
    
ErrCode:
    ToolErr.UbsErrMsg "DoAsincReport", "ошибка выполнения"
End Sub

Private Sub UserDocument_Hide()
       
    If blnRespond Then
        Dim k
        
        For k = 0 To UbsChnlAsync.UBound()
            UbsChnlAsync(k).StopRun
        Next
        
        While blnRespond
            DoEvents
        Wend
        
        For k = 0 To UbsChnlAsync.UBound()
            UbsChnlAsync(k).UnLoadResource
        Next
    End If
    UbsChannel.UnLoadResource
    ScriptRunner.Clear
         
    Set User = Nothing
    Set ToolPubs = Nothing
    Set ToolErr = Nothing
    Set UbsFile = Nothing
    Set ScriptRunner = Nothing
    Set objInParam = Nothing
    Set objOutParam = Nothing
    Set WaitBox = Nothing
  
  If CallWindowClose = False Then
    Dim NeedRefreshGrid As Variant
    NeedRefreshGrid = NeedRefresh
    If NumCallWindow <> 0 Then
      If Parent.IsExistParam(NumCallWindow, "NeedRefreshGrid") Then
        Parent.ParamInfo(NumCallWindow, "NeedRefreshGrid") = NeedRefreshGrid
      End If
    End If
  End If
End Sub

Private Sub UserDocument_Initialize()
    ReDim ArrParam(2)
    ArrParam(0) = "WaitShow"
    ArrParam(1) = "InitParamGrid"
    ArrParam(2) = "LoadFromMenu"
    IdProcessing = 0
  
    Label1.Caption = ""
End Sub

Private Sub Initialize()
    NeedRefresh = False
    CallWindowClose = False
    Set ToolPubs = CreateObject("ToolPubs.Interfaces")
    Set ToolErr = CreateObject("ToolPubs.IUbsError")
    Set UbsFile = CreateObject("Lib1.IUbsFile")
    Set objInParam = CreateObject("Lib2.IUbsParam")
    Set objOutParam = CreateObject("Lib2.IUbsParam")
    Set objArray = CreateObject("Lib1.IUbsArray")
    
End Sub


Private Sub UserDocument_KeyPress(KeyAscii As Integer)
On Error GoTo ErrorCode

  Select Case (KeyAscii)
    Case 13
      KeyAscii = Asc(Chr(0))
      If UserDocument.ActiveControl.Name = "PathFile" And Len(Trim(PathFile.Text)) > 0 Then
         Go.SetFocus
      Else
         ToolPubs.NextCtrl
      End If
    Case 27
      KeyAscii = Asc(Chr(0))
      ToolPubs.PrevCtrl
  End Select
  Exit Sub

ErrorCode:
  ToolErr.UbsErrMsg "UserDocument_KeyPress", "ошибка выполнения"

End Sub
