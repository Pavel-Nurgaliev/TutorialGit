Attribute VB_Name = "PCOper_FIn"
Attribute VB_GlobalNameSpace = False
Attribute VB_Creatable = True
Attribute VB_PredeclaredId = False
Attribute VB_Exposed = True
Attribute VB_Ext_KEY = "VBD_Name" ,"UBS_VBD\PLCARD\PCOper_FIn.htm"
Attribute VB_Ext_KEY = "VBD_BuildName" ,"UBS_VBD\PLCARD\PCOper_FIn.htm"
Attribute VB_Ext_KEY = "VBD_Description" ,"Выполнение загруженных операций из процесс.центра"
Attribute VB_Ext_KEY = "VBD_Business" ,"Пластиковые карты"
Attribute VB_Ext_KEY = "VBD_InMenu" ,"0"
Option Explicit
Implements UBSChild
Dim Parent As UBSParrent
Dim NumWin As Integer, NumCallWindow As Integer
Dim CallWindowClose As Boolean, NeedRefresh As Boolean
Dim FixMyWindow As Boolean
Dim ArrParam As Variant
Dim UbsFile As Object

Dim User As Object
Dim ToolPubs As Object
Dim ToolErr As Object
Dim ScriptRunner As Object
Dim IdFile As Long
Dim ClientFileName As String

Dim nCountChanel As Integer
Dim objInParam As Object
Dim objOutParam As Object
Dim WaitBox
Dim blnRespond As Boolean

Dim lngRecordCounter As Long, lngRecordUp As Long

Private Sub cmdExit_Click()
On Error GoTo ErrorCode
If blnRespond Then
   Dim x As Integer
   For x = 0 To UbsChnlAsync.UBound()
       UbsChnlAsync(x).StopRun
   Next
                  
   While blnRespond
         DoEvents
   Wend
End If

Parent.CloseWindow NumWin

Exit Sub

ErrorCode:
  ToolErr.UbsErrMsg "cmdExit_Click", "ошибка выполнения"

End Sub

Private Sub Load_Click()
On Error GoTo ErrorCode
    If DateIn.DateValue = #1/1/2222# Then
        MsgBox "Не установлена дата операции", , "Ошибка"
        DateIn.SetFocus
        Exit Sub
    End If
    ' отчет об обработанных
    lngRecordCounter = 0
    lngRecordUp = 0
    Call UbsChnlAsync_Notice(0, "OK: 0")
    
    UserDocument.MousePointer = 11
    ScriptRunner.ReadAction "UBS_PLCARD_FILE_INP_OPERATION_LOAD" '"UBS_VBS_PLCARD_FILE_IN_L"
    ScriptRunner.ClearParameters
  
    '================= Для обработки операций в несколько (от 1-7 потоков)
    objInParam.Parameter("IdFile") = IdFile
    objInParam.Parameter("State") = 255
    Call UbsChannel.Run("PCPRCFile_SetStateParam", objInParam, objOutParam)
    
    Dim varDataOper
    ScriptRunner.Run "ReceiveRawOperOfProcessing", IdFile, DateIn.DateValue, varDataOper
  
    If IsArray(varDataOper) Then
        Dim v
        Dim N As Integer
      
        lngRecordCounter = UBound(varDataOper, 2) + 1
        Call UbsChnlAsync_Notice(0, "OK: 0")
        v = DivideIntoParts(varDataOper, nCountChanel)
        blnRespond = True
       ' MsgBox UBound(v)
        For N = 0 To UBound(v)
     
            If IsArray(v(N)) Then

                objInParam.Parameter("RS") = v(N)
                objInParam.Parameter("Номер канала") = N
                objInParam.Parameter("DateOper") = DateIn.DateValue
                objInParam.Parameter("IdFile") = IdFile
                objInParam.ClearParameter "ReportError"
            
                UbsChnlAsync(N).Tag = "Активный"
         
                lblChannelInfo(N).BackColor = RGB(165, 80, 100)
         
                UbsChnlAsync(N).RunAsync "ProcessOperationsOfProcessing_Async", objInParam
            End If
        Next
     
        Load.Caption = "Обработка операций..."
        Load.Enabled = False
        cmdExit.Caption = "Отмена"
    Else
        Load.Enabled = True
        Load.Caption = "Выполнить"
        
        objInParam.Parameter("IdFile") = IdFile
        objInParam.Parameter("State") = 0
        Call UbsChannel.Run("PCPRCFile_SetStateParam", objInParam, objOutParam)
        
        MsgBox "Данных для обработки нет!", vbInformation, "Довыполнение операций по файлу"
    End If
  
    UserDocument.MousePointer = 0
    NeedRefresh = True
Exit Sub

ErrorCode:
  UserDocument.MousePointer = 0
  ToolErr.UbsErrMsg "Load_Click", "ошибка выполнения"
End Sub

Private Property Get UBSChild_ActualParameter() As Variant
End Property

Private Property Get UBSChild_Height() As Integer
  UBSChild_Height = UserDocument.MinHeight
End Property

Private Property Let UBSChild_HeightBrowser(ByVal RHS As Variant)

End Property

Private Property Get UBSChild_ImageList(Key As String) As Object
  Key = "PROCESS"
End Property

Private Property Get UBSChild_IsExistParam(ByVal NameParam As String) As Boolean
  Dim ss As Variant
  UBSChild_IsExistParam = False
  For Each ss In ArrParam
    If ss = NameParam Then
      UBSChild_IsExistParam = True
      Exit For
    End If
  Next
End Property

Private Sub UBSChild_NotifyCloseWindow(ByVal NumWindow As Integer)
  If NumWindow = NumCallWindow Then
    CallWindowClose = True
    If FixMyWindow = False Then
       cmdExit_Click
    End If
  End If
End Sub

Private Sub UBSChild_NotifyFixWindow(ByVal NumWindow As Variant, ByVal FixState As Boolean)
  If NumWindow = NumWin Then
    FixMyWindow = FixState
  End If
End Sub

Private Property Let UBSChild_NumWindow(ByVal RHS As Integer)
  NumWin = RHS
End Property

Private Property Let UBSChild_ParamInfo(ByVal NameParam As String, ByVal RHS As Variant)
On Error GoTo ErrorCode
  Dim ItemArray As Variant
  Select Case NameParam
    Case "InitParamForm"
      Initialize
      NumCallWindow = RHS(0)
      ItemArray = RHS(1)
      If IsEmpty(ItemArray) Then
        ToolErr.UbsErrRaise "UBSChild_ParamInfo", "[InitParamForm]: Массив идентификаторов пуст"
      End If
      IdFile = ItemArray(0)
      If IdFile = 0 Then
        ToolErr.UbsErrRaise "UBSChild_ParamInfo", "[InitParamForm]: Идентификатор файла равен 0"
      End If
      
        ' Проверка на дообработку другим пользователем
        UbsChannel.LoadResource = "VBS:UBS_VBS\PLCARD\Processing\PCPRCFile.vbs"
        objInParam.Parameter("IdFile") = IdFile
        objInParam.Parameter("TypeFile") = "операции из ПЦ"
        UbsChannel.Run "PCPRCFile_CanProcessParam", objInParam, objOutParam
        If Trim(objOutParam.Parameter("strError")) <> "" Then _
            ToolErr.UbsErrRaise "UBSChild_ParamInfo", objOutParam.Parameter("strError")
      
      InitFile
      Parent.WindowDraw(NumWin) = True
      ToolPubs.NextCtrl
      ToolPubs.PrevCtrl
      DateIn.SetFocus
      Exit Property
    Case Else
      ToolErr.UbsErrRaise "UBSChild_ParamInfo", "Параметр " & NameParam & " не поддерживается"
  End Select

ErrorCode:
  ToolErr.UbsErrMsg "UBSChild_ParamInfo", "ошибка выполнения"
  Parent.CloseWindow NumWin
End Property

Private Property Get UBSChild_ParamInfo(ByVal NameParam As String) As Variant
  If NameParam = "WaitShow" Then
    UBSChild_ParamInfo = True
  End If
End Property

Private Property Let UBSChild_Parrent(ByVal RHS As Object)
  Set Parent = RHS
End Property

Private Property Let UBSChild_RunParameter(ByVal RHS As String)

End Property

Private Property Get UBSChild_Sizable() As Boolean
  UBSChild_Sizable = False
End Property

Private Property Get UBSChild_TitleWindow() As String
  UBSChild_TitleWindow = "Выполнение операций проц.центра из загруженного файла"
End Property

Private Property Get UBSChild_Width() As Integer
  UBSChild_Width = UserDocument.MinWidth
End Property

Private Property Let UBSChild_WidthBrowser(ByVal RHS As Variant)

End Property

Private Sub InitFile()
On Error GoTo ErrorCode
  Dim WR As Object
  Dim arrSetting As Variant
  Set User = Parent.User
  Set ScriptRunner = CreateObject("URunScr.IUbsRunScript")
  ScriptRunner.UbsUser = User
  ScriptRunner.DataAccess = User.CreateObject("UbsDataAccess")
  Set WR = User.CreateObject("UbsWriteRead")
  WR.UbsUser = User
  WR.DataAccess = User.CreateObject("UbsDataAccess")
  WR.TypeTable = 1
  WR.ClearFileRecord
  WR.FileParam("Id_File") = CLng(IdFile)
  WR.ReadFileRecord
  DateIn.DateValue = WR.FileParam("DateFile")
  NameFile.Caption = WR.FileParam("NameFile")

  'Читаем кол-во потоков
  Dim j As Integer
    
    arrSetting = User.ReadSetting("Пластиковые карты", "Количество потоков")
    nCountChanel = 0
    If IsArray(arrSetting) Then
        For j = 0 To UBound(arrSetting, 2)
            If CStr(arrSetting(0, j)) = CStr("Обработка операций из ПЦ") Then
                nCountChanel = arrSetting(1, j)
            End If
        Next
        If nCountChanel = 0 Then
            MsgBox "Неправильно настроена установка 'Количество потоков' для операции 'Обработка операций из ПЦ'", vbCritical, "Ошибка!"
            Parent.CloseWindow NumWin
            Exit Sub
        End If
    Else
        MsgBox "Не найдена установка 'Количество потоков'", vbCritical, "Ошибка!"
        Parent.CloseWindow NumWin
        Exit Sub
        End If
  
  If nCountChanel < 1 Then nCountChanel = 1
  If nCountChanel > 7 Then nCountChanel = 7
    
  For j = 0 To 6
      If lblChannelInfo(j).Index <= nCountChanel - 1 Then
         lblChannelInfo(j).Visible = True
      Else
         lblChannelInfo(j).Visible = False
      End If
  Next
  
  Call InitChannelAsync("VBS:UBS_VBS\PLCARD\OPENWAY\PCFileOperOW.vbs", nCountChanel, Parent, NumWin, UbsChnlAsync)
  '=========================================
  
  Exit Sub
ErrorCode:
  ToolErr.UbsMsgRaise "InitFile", "ошибка выполнения"
End Sub

Private Sub UbsChnlAsync_Error(Index As Integer, ByVal ErrorDescription As String)

On Error GoTo ErrCode

    lblChannelInfo(Index).BackColor = RGB(255, 0, 0)
    
    objInParam.ClearParameters
    objInParam.Parameter("Error") = ErrorDescription
    objInParam.Parameter("NC") = Index + 1
    
    UbsChnlAsync(Index).RunAsync "ProcessOperationsOfProcessing_AsyncIfError", objInParam
    
    Exit Sub
ErrCode:
    blnRespond = False
    ToolErr.UbsErrMsg "UbsChnlAsync_Error", "ошибка выполнения"
End Sub

Private Sub UbsChnlAsync_Notice(Index As Integer, ByVal TextNotice As String)
    Dim nOK As Long
    Dim strReport As String
    
    On Error GoTo ErrCode
    
    nOK = 0
    strReport = "Обработано {0} сообщений из " & lngRecordCounter
    
    If Len(TextNotice) > 3 Then
        If Left(TextNotice, 3) = "OK:" Then
            On Error Resume Next
            nOK = CLng(Trim(Mid(TextNotice, 4)))
            lngRecordUp = lngRecordUp + nOK
            On Error GoTo ErrCode
            lblProgress.Caption = Replace(strReport, "{0}", lngRecordUp)
        End If
    End If
    
    Exit Sub

ErrCode:
    ToolErr.UbsErrMsg "UbsChnlAsync_Notice", "ошибка выполнения"
End Sub

Private Sub UbsChnlAsync_Respond_OLD(Index As Integer, ByVal LastRespond As Boolean, OutParams As Object)
    
    Dim bIsOk As Boolean
    Dim c, g As Integer

On Error GoTo ErrorCode

    If OutParams.ExistParameter("ReportError") Then
        ' на случай глобальных ошибок
        MsgBox OutParams.Parameter("ReportError"), vbCritical, "Ошибка!"
        cmdExit.Caption = "Выход"
        cmdExit.Enabled = True
        Load.Caption = "Загрузка!"
        Load.Enabled = True
        For c = 0 To lblChannelInfo().UBound
            lblChannelInfo(c).BackColor = Load.BackColor
        Next
        blnRespond = False
        ClientFileName = ""
        Exit Sub
    Else
        Dim objFile As Object
        Dim SrvFileNameFull As String, SrvFileName As String, ClientFileNameTmp As String
        Dim nPos As Long
        Set objFile = CreateObject("Lib1.IUbsFile") ' промежуточные файлы
        Set WaitBox = CreateObject("UbsWait.UbsWaitBox")
        
        ScriptRunner.LoadFiles "UBS_VBS\SYSTEM\SYSToolFiles.vbs"
        ' Создаю один файл на клиенте(итоговый)
        If ClientFileName = "" Then
            ClientFileName = UbsFile.GetTempFile
            If Not UbsFile.OpenTextFile(ClientFileName, False) Then
                MsgBox "Файл-протокол " & ClientFileName & " не открыт на запись", vbCritical, "Ошибка!"
                Exit Sub
            End If
        End If
        
        SrvFileNameFull = OutParams.Parameter("Имя файла")
        
        nPos = InStrRev(SrvFileNameFull, "\")
        If nPos <> 0 Then
            SrvFileName = Right(SrvFileNameFull, Len(SrvFileNameFull) - nPos)
        Else
            SrvFileName = SrvFileNameFull
        End If
        
        ClientFileNameTmp = UbsFile.GetTempFile
        objFile.DeleteFile ClientFileNameTmp
           
        ' копируем файл-отчет на клиент
        UbsChannel.GetFile ClientFileNameTmp, "Temp", SrvFileName

        ' удаляем файл с сервера
        ScriptRunner.Run "DeleteServerFileEx", "Temp", SrvFileName
                
        ' пишу в итоговый
        UbsFile.WriteLine objFile.ReadAll(ClientFileNameTmp)
        
        objFile.CloseFile
        objFile.DeleteFile ClientFileNameTmp
            
        bIsOk = True
        
        lblChannelInfo(Index).BackColor = RGB(255, 255, 255)
        
        UbsChnlAsync(Index).Tag = ""
        For c = 0 To UbsChnlAsync.UBound()
            If UbsChnlAsync(c).Tag <> "" Then bIsOk = False
        Next
                
        If bIsOk Then
            UbsFile.CloseFile
            WaitBox.FileName = ClientFileName
            cmdExit.Caption = "Выход"
            cmdExit.Enabled = True
            Load.Caption = "Загрузка!"
            Load.Enabled = True
            For c = 0 To lblChannelInfo().UBound
                lblChannelInfo(c).BackColor = Load.BackColor
            Next
            WaitBox.MaximizeView
            WaitBox.ViewFile
            blnRespond = False
            Set WaitBox = Nothing
            
            UbsFile.DeleteFile ClientFileName
            ClientFileName = ""
        End If
    
        Exit Sub
    End If

ErrorCode:
    ToolErr.UbsErrMsg "UbsChnlAsync_Respond", "ошибка выполнения"
End Sub

Private Sub UbsChnlAsync_Respond(Index As Integer, ByVal LastRespond As Boolean, OutParams As Object)
    
    Dim bIsOk As Boolean
    Dim c, g As Integer

On Error GoTo ErrorCode

    If OutParams.ExistParameter("ReportError") Then
        ' на случай глобальных ошибок
        MsgBox OutParams.Parameter("ReportError"), vbCritical, "Ошибка!"
        cmdExit.Caption = "Выход"
        cmdExit.Enabled = True
        Load.Caption = "Загрузка!"
        Load.Enabled = True
        For c = 0 To lblChannelInfo().UBound
            lblChannelInfo(c).BackColor = Load.BackColor
        Next
        blnRespond = False
        ClientFileName = ""
        Exit Sub
    Else
        Dim objFile As Object
        Dim SrvFileNameFull As String, SrvFileName As String, ClientFileNameTmp As String
        Dim nPos As Long
        Set objFile = CreateObject("Lib1.IUbsFile") ' промежуточные файлы
        Set WaitBox = CreateObject("UbsWait.UbsWaitBox")
        
        ScriptRunner.LoadFiles "UBS_VBS\SYSTEM\SYSToolFiles.vbs"
        ' Создаю один файл на клиенте(итоговый)
        If ClientFileName = "" Then
            ClientFileName = UbsFile.GetTempFile
            If Not UbsFile.OpenTextFile(ClientFileName, False) Then
                MsgBox "Файл-протокол " & ClientFileName & " не открыт на запись", vbCritical, "Ошибка!"
                Exit Sub
            End If
        End If
        
        SrvFileNameFull = OutParams.Parameter("Имя файла")
        
        nPos = InStrRev(SrvFileNameFull, "\")
        If nPos <> 0 Then
            SrvFileName = Right(SrvFileNameFull, Len(SrvFileNameFull) - nPos)
        Else
            SrvFileName = SrvFileNameFull
        End If
        
        ClientFileNameTmp = UbsFile.GetTempFile
        objFile.DeleteFile ClientFileNameTmp
           
        ' копируем файл-отчет на клиент
        UbsChannel.GetFile ClientFileNameTmp, "Temp", SrvFileName

        ' удаляем файл с сервера
        ScriptRunner.Run "DeleteServerFileEx", "Temp", SrvFileName
                
        ' пишу в итоговый
        UbsFile.WriteLine objFile.ReadAll(ClientFileNameTmp)
        
        objFile.CloseFile
        objFile.DeleteFile ClientFileNameTmp
            
        bIsOk = True
        
        lblChannelInfo(Index).BackColor = RGB(255, 255, 255)
        
        UbsChnlAsync(Index).Tag = ""
        For c = 0 To UbsChnlAsync.UBound()
            If UbsChnlAsync(c).Tag <> "" Then bIsOk = False
        Next
                
        If bIsOk Then
            UbsFile.CloseFile
            WaitBox.FileName = ClientFileName
            cmdExit.Caption = "Выход"
            cmdExit.Enabled = True
            Load.Caption = "Загрузка!"
            Load.Enabled = True
            For c = 0 To lblChannelInfo().UBound
                lblChannelInfo(c).BackColor = Load.BackColor
            Next
        
            objInParam.Parameter("IdFile") = IdFile
            objInParam.Parameter("State") = 0
            Call UbsChannel.Run("PCPRCFile_SetStateParam", objInParam, objOutParam)
            
            WaitBox.MaximizeView
            WaitBox.ViewFile
            blnRespond = False
            Set WaitBox = Nothing
            
            UbsFile.DeleteFile ClientFileName
            ClientFileName = ""
        End If
    
        Exit Sub
    End If

ErrorCode:
    ToolErr.UbsErrMsg "UbsChnlAsync_Respond", "ошибка выполнения"
End Sub

Private Sub UserDocument_Hide()
       
  If blnRespond Then
     Dim k

     For k = 0 To UbsChnlAsync.UBound()
         UbsChnlAsync(k).StopRun
     Next
     
     While blnRespond
           DoEvents
     Wend
     
  End If
   
  Set User = Nothing
  Set ToolPubs = Nothing
  Set ToolErr = Nothing
  Set ScriptRunner = Nothing
  Set objInParam = Nothing
  Set objOutParam = Nothing
  Set UbsFile = Nothing
  If CallWindowClose = False Then
    Dim NeedRefreshGrid As Variant
    NeedRefreshGrid = NeedRefresh
    If NumCallWindow <> 0 Then
      If Parent.IsExistParam(NumCallWindow, "NeedRefreshGrid") Then
        Parent.ParamInfo(NumCallWindow, "NeedRefreshGrid") = NeedRefreshGrid
      End If
    End If
  End If
End Sub

Private Sub UserDocument_Initialize()
    ReDim ArrParam(1)
    ArrParam(0) = "WaitShow"
    ArrParam(1) = "InitParamGrid"
    lblProgress.Caption = ""
End Sub

Private Sub Initialize()
    NeedRefresh = False
    CallWindowClose = False
    Set ToolPubs = CreateObject("ToolPubs.Interfaces")
    Set ToolErr = CreateObject("ToolPubs.IUbsError")
    Set objInParam = CreateObject("Lib2.IUbsParam")
    Set objOutParam = CreateObject("Lib2.IUbsParam")
    Set UbsFile = CreateObject("Lib1.IUbsFile")
    
    UbsChannel.HostAddress = Parent.LoaderParamInfo(NumWin, "HostAddress")
    UbsChannel.UserGUID = Parent.LoaderParamInfo(NumWin, "GuidSession")
    'UbsChannel.LoadResource = "VBS:UBS_VBS\SYSTEM\Empty.vbs"
    UbsChannel.LoadResource = "VBS:UBS_VBS\PLCARD\Processing\PCPRCFile.vbs"
    UbsChannel.FormatParamIn = "XML"
    UbsChannel.FormatParamOut = "XML"

End Sub
