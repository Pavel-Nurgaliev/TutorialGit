Private Sub InitFile()
    Dim Setup As Object
    Dim ArrPath As Variant
    Dim j, arrSetting
    Dim i As Integer
    Dim strValue As String
    Dim arrValue As Variant
    
    On Error GoTo ErrorCode
    
    Set User = Parent.User
    Set ScriptRunner = CreateObject("URunScr.IUbsRunScript")
    ScriptRunner.UbsUser = User
    ScriptRunner.DataAccess = User.CreateObject("UbsDataAccess")
    ScriptRunner.UbsChannel = UbsChannel
  
    DateIn.DateValue = User.CommonDate("Server")


    Set Setup = User.CreateObject("UbsSetup")
    Setup.UbsUser = User
    ArrPath = Setup.ReadSetting("Пластиковые карты", "Прием и выгрузка файлов", 1, "SS")
    PathFile.Text = GetSettingFilePath("Прием файла заработной платы", ArrPath, User.Division)

    'Трубаков В
    '-----------------------------------
    cmbFindCard.AddItem "по номеру карты"
    cmbFindCard.ItemData(0) = CLng(0)
    cmbFindCard.AddItem "по номеру счета"
    cmbFindCard.ItemData(1) = CLng(1)

    arrValue = Setup.ReadSetting("Пластиковые карты", "Форматы файлов", 0, "SS")
    If IsArray(arrValue) Then
        For i = 0 To UBound(arrValue, 2)
            If arrValue(0, i) = "Файл с заработной платой" Then
                strValue = arrValue(1, i)
                Exit For
            End If
        Next
    End If

    If UCase(strValue) = "ТАТФОНД" Then
        cmbFindCard.ListIndex = 0
    Else
        cmbFindCard.ListIndex = 1
    End If
    '-----------------------------------

    For i = 0 To UBound(ArrPath, 2)
           CommonDlg.InitDir = PathFile.Text
    Next

    ' ===========
    arrSetting = User.ReadSetting("Пластиковые карты", "Количество потоков")
    nCountChanel = 0
    If IsArray(arrSetting) Then
        For j = 0 To UBound(arrSetting, 2)
            If CStr(arrSetting(0, j)) = CStr("Обработка файла по зарплате/пополнению/списанию") Then
                nCountChanel = arrSetting(1, j)
            End If
        Next
        If nCountChanel = 0 Then
            MsgBox "Неправильно настроена установка 'Количество потоков' для операции 'Обработка файла по зарплате/пополнению/списанию'", vbCritical, "Ошибка!"
            Parent.CloseWindow NumWin
            Exit Sub
        End If
    Else
        MsgBox "Не найдена установка 'Количество потоков'", vbCritical, "Ошибка!"
        Parent.CloseWindow NumWin
        Exit Sub
    End If
    If nCountChanel < 1 Then nCountChanel = 1
    If nCountChanel > 7 Then nCountChanel = 7

    For j = 0 To 6
        If lblChannelInfo(j).Index <= nCountChanel - 1 Then
            lblChannelInfo(j).Visible = True
        Else
            lblChannelInfo(j).Visible = False
        End If
    Next
   
    Call InitChannelAsync("VBS:UBS_VBS\PLCARD\OPENWAY\PCSalaryImport.vbs", nCountChanel, Parent, NumWin, UbsChnlAsync)
   
    ' ----------------------------------------------------
    ' Типы платежных поручений для обработки
    frmPaymentOrder.ListPaymentOrder.Clear
    
    UbsChannel.Run "PCSalaryImport_GetTypePaymentOrder", ParamIn, ParamOut
    varTypePaymentOrder = ParamOut.Parameter("Типы платежных поручений")
    If IsArray(varTypePaymentOrder) Then
        For i = 0 To UBound(varTypePaymentOrder, 2)
            frmPaymentOrder.ListPaymentOrder.AddItem varTypePaymentOrder(2, i)
            frmPaymentOrder.ListPaymentOrder.ItemData(frmPaymentOrder.ListPaymentOrder.NewIndex) = varTypePaymentOrder(0, i)
        Next
        frmPaymentOrder.ListPaymentOrder.ListIndex = 0
    End If
    ' ----------------------------------------------------
   
    ' ----------------------------------------------------
    ' Вид дохода
    varGainType = User.ReadSetting("Операционный день", "Кодовые назначения платежа")
    cmbGainType.Clear
    cmbGainType.AddItem ""
    cmbGainType.ItemData(0) = -1
    If IsArray(varGainType) Then
        For i = 0 To UBound(varGainType, 2)
            If UCase(varGainType(0, i)) = "ВИД ДОХОДА" Then
                cmbGainType.AddItem varGainType(2, i)
                cmbGainType.ItemData(cmbGainType.NewIndex) = i
                If varGainType(1, i) = "1" Then
                    cmbGainType.ListIndex = cmbGainType.NewIndex
                End If
            End If
        Next
    End If
    ' ----------------------------------------------------
    
    Exit Sub
    
ErrorCode:
   ToolErr.UbsMsgRaise "InitFile", "ошибка выполнения"
End Sub

Private Sub UbsChnlAsync_Error(Index As Integer, ByVal ErrorDescription As String)
    On Error GoTo ErrCode

'MsgBox "UbsChnlAsync_Error(" & Index & ") = " & ErrorDescription, , "qwe"

    lblChannelInfo(Index).BackColor = RGB(255, 0, 0)
    
    objInParam.ClearParameters
    objInParam.Parameter("Error") = ErrorDescription
    objInParam.Parameter("NC") = Index + 1
    
    UbsChnlAsync(Index).RunAsync "PCSalaryImport__AsyncError", objInParam
    
    Exit Sub

ErrCode:
    blnRespond = False
    ToolErr.UbsErrMsg "UbsChnlAsync_Error", "ошибка выполнения"
End Sub

Private Sub UbsChnlAsync_Notice(Index As Integer, ByVal TextNotice As String)
    Dim nOK As Long
    Dim strReport As String
    
    On Error GoTo ErrCode
'MsgBox "UbsChnlAsync_Notice(" & Index & ") = " & TextNotice, , "qwe"
    nOK = 0
    strReport = "Обработано {0} сообщений из " & lngRecordCounter
    
    If Len(TextNotice) > 3 Then
        If Left(TextNotice, 3) = "OK:" Then
            On Error Resume Next
            nOK = CLng(Trim(Mid(TextNotice, 4)))
            lngRecordUp = lngRecordUp + nOK
            On Error GoTo ErrCode
            lblProgress.Caption = Replace(strReport, "{0}", lngRecordUp)
        End If
    End If
    
    Exit Sub

ErrCode:
    ToolErr.UbsErrMsg "UbsChnlAsync_Notice", "ошибка выполнения"
End Sub

Private Sub UbsChnlAsync_Respond(Index As Integer, ByVal LastRespond As Boolean, OutParams As Object)
    Dim bIsOk As Boolean
    Dim c, g, lngItemZPT, lngItemZP As Integer
    Dim varZPTmp
    Dim var, i
    

    On Error GoTo ErrorCode
    
 CountResponce = CountResponce + 1
'    MsgBox CountResponce
      '  MsgBox CountResponce & "xxxxx" & CountResponceMax


    If OutParams.ExistParameter("ReportError") Then
        Dim w: Set w = CreateObject("UbsWait.UbsWaitBox")
        w.WriteLine = OutParams.Parameter("ReportError")
        w.ViewFile
        w.MaximizeView
        Set w = Nothing
        
        ' на случай глобальных ошибок
        'MsgBox OutParams.Parameter("ReportError"), vbCritical, "Ошибка!"
        cmdExit.Caption = "Выход"
        cmdExit.Enabled = True
        Load.Caption = "Загрузка!"
        Load.Enabled = True
        For c = 0 To lblChannelInfo().UBound
            lblChannelInfo(c).BackColor = Load.BackColor
        Next
        blnRespond = False
        ClientFileName = ""
        Exit Sub
    Else
        Dim objFile As Object
        Dim SrvFileNameFull As String, SrvFileName As String, ClientFileNameTmp As String
        Dim nPos As Long
        Set objFile = CreateObject("Lib1.IUbsFile") ' промежуточные файлы
        Set WaitBox = CreateObject("UbsWait.UbsWaitBox")
        
        ' Создаю один файл на клиенте(итоговый)
        If ClientFileName = "" Then
            ClientFileName = UbsFile.GetTempFile
            If Not UbsFile.OpenTextFile(ClientFileName, False) Then
                MsgBox "Файл-протокол " & ClientFileName & " не открыт на запись", vbCritical, "Ошибка!"
                Exit Sub
            End If
        End If
        
        'здесь описана обработка массива с различными счетами по зп, на момент написания в нем должна быть всего одна строка
        If chkControlRun.Value = vbChecked Then
            If OutParams.ExistParameter("varZPData") Then
                varZPTmp = OutParams.Parameter("varZPData")
                
                If IsEmpty(varZPData) Then
                    ReDim varZPData(4, 0)
                    varZPData(0, 0) = 0  'ID счета
                    varZPData(1, 0) = "" 'счет
                    varZPData(2, 0) = 0  'сальдо
                    varZPData(3, 0) = 0  'сумма зп
                    varZPData(4, 0) = 0  'сумма комиссии
                End If
                
                'переносим пришедшие данные по зарплате в общий массив
                For lngItemZP = 0 To UBound(varZPData, 2)
                    For lngItemZPT = 0 To UBound(varZPTmp, 2)
                        If varZPData(0, lngItemZP) = varZPTmp(0, lngItemZPT) Then
                            varZPData(3, lngItemZP) = varZPData(3, lngItemZP) + varZPTmp(3, lngItemZPT)
                            varZPData(4, lngItemZP) = varZPData(4, lngItemZP) + varZPTmp(4, lngItemZPT)
                            
                            varZPTmp(0, lngItemZPT) = 0 'трем ИД, используем как флаг
                        End If
                    Next
                Next
                
                'добавили данные, смотрим, есть ли новые и добавляем их в массив
                For lngItemZPT = 0 To UBound(varZPTmp, 2)
                    If varZPTmp(0, lngItemZPT) > 0 Then
                        
                        If varZPData(0, 0) = 0 Then
                            'запись первой строки данных
                            varZPData(0, 0) = varZPTmp(0, lngItemZPT)
                            varZPData(1, 0) = varZPTmp(1, lngItemZPT)
                            varZPData(2, 0) = varZPTmp(2, lngItemZPT)
                            varZPData(3, 0) = varZPTmp(3, lngItemZPT)
                            varZPData(4, 0) = varZPTmp(4, lngItemZPT)
                        Else
                            'запись последующих строк
                            lngItemZP = UBound(varZPData, 2) + 1
                            ReDim Preserve varZPData(4, lngItemZP)
                            varZPData(0, lngItemZP) = varZPTmp(0, lngItemZPT)
                            varZPData(1, lngItemZP) = varZPTmp(1, lngItemZPT)
                            varZPData(2, lngItemZP) = varZPTmp(2, lngItemZPT)
                            varZPData(3, lngItemZP) = varZPTmp(3, lngItemZPT)
                            varZPData(4, lngItemZP) = varZPTmp(4, lngItemZPT)
                        End If
                        
                    End If
                Next
                
            End If
        End If
        
        SrvFileNameFull = OutParams.Parameter("Имя файла")
        
        nPos = InStrRev(SrvFileNameFull, "\")
        If nPos <> 0 Then
            SrvFileName = Right(SrvFileNameFull, Len(SrvFileNameFull) - nPos)
        Else
            SrvFileName = SrvFileNameFull
        End If
        
        ClientFileNameTmp = UbsFile.GetTempFile
        objFile.DeleteFile ClientFileNameTmp
           
        ' копируем файл-отчет на клиент
        UbsChannel.GetFile ClientFileNameTmp, "Temp", SrvFileName

        ' удаляем файл с сервера
        ScriptRunner.Run "DeleteServerFileEx", "Temp", SrvFileName
                
        ' пишу в итоговый
        UbsFile.WriteLine objFile.ReadAll(ClientFileNameTmp)
        
        objFile.CloseFile
        objFile.DeleteFile ClientFileNameTmp
            
        bIsOk = True
        
        lblChannelInfo(Index).BackColor = RGB(255, 255, 255)
        
        UbsChnlAsync(Index).Tag = ""
        For c = 0 To UbsChnlAsync.UBound()
            If UbsChnlAsync(c).Tag <> "" Then bIsOk = False
        Next
                
        If OutParams.ExistParameter("Сводный платеж.Массив документов") Then
            var = OutParams.Parameter("Сводный платеж.Массив документов")
            If IsArray(var) Then
                For i = 0 To UBound(var, 2)
                    If IsArray(varDoc) Then
                        ReDim Preserve varDoc(2, UBound(varDoc, 2) + 1)
                    Else
                        ReDim varDoc(2, 0)
                    End If
                    varDoc(0, UBound(varDoc, 2)) = var(0, i)
                    varDoc(1, UBound(varDoc, 2)) = var(1, i)
                    varDoc(2, UBound(varDoc, 2)) = var(2, i)
                Next
            End If
        End If

Dim bSetFileState As Boolean: bSetFileState = True

        If bIsOk Then
            'для протокола в контрольном режиме
            If chkControlRun.Value = vbChecked Then
                If IsArray(varZPData) Then
                    For lngItemZP = 0 To UBound(varZPData, 2)
                        UbsFile.WriteLine "Со счета '" & varZPData(1, lngItemZP) & "'" _
                            & ", сальдо = " & Trim(objFormat.FixToSaldo(varZPData(2, lngItemZP), 20, 2, "-")) & "," _
                            & " списывается заработная плата общей суммой = " & Trim(objFormat.FixToSaldo(varZPData(3, lngItemZP), 20, 2, "-")) _
                            & " и суммой комиссии = " & Trim(objFormat.FixToSaldo(varZPData(4, lngItemZP), 20, 2, "-"))
                            
' (79521)
'                        If (varZPData(3, lngItemZP) + varZPData(4, lngItemZP)) > varZPData(2, lngItemZP) Then
'                            UbsFile.WriteLine "ОШИБКА!!!! Сумма списываемых средств превышает сальдо счета на " _
'                                & Trim(objFormat.FixToSaldo(((varZPData(3, lngItemZP) + varZPData(4, lngItemZP)) - varZPData(2, lngItemZP)), 20, 2, "-"))
'                        End If
                                
                        ParamIn.ClearParameters
                        ParamOut.ClearParameters
                        ParamIn.Parameter("DateTrn") = DateIn.DateValue
                        ParamIn.Parameter("Salary.Payment.IdAccDB") = varZPData(0, lngItemZP)
                        ParamIn.Parameter("Salary.Payment.AccDB") = varZPData(1, lngItemZP)
                        ParamIn.Parameter("Salary.Payment.SaldoAccDB") = varZPData(2, lngItemZP)
                        ParamIn.Parameter("Salary.Payment.curDB") = varZPData(3, lngItemZP)
                        ParamIn.Parameter("Salary.Fee.curDB") = varZPData(4, lngItemZP)
                        UbsChannel.Run "PCSalaryImport_CheckMoveFunds", ParamIn, ParamOut
                        If Not CBool(ParamOut.Parameter("bResult")) Then
                            UbsFile.WriteLine "ОШИБКА!!!! " & ParamOut.Parameter("StrReport")
                        End If
                    Next
                End If
            Else
                If PaymentOrderId > 0 And PaymentOrderType = "RC" Then
                    ParamIn.ClearParameters
                    ParamOut.ClearParameters
                    
                    ParamIn.Parameter("Сводный платеж.Идентификатор") = PaymentOrderId
                    ParamIn.Parameter("Сводный платеж.Массив документов") = varDoc
                    
                    UbsChannel.Run "PCSalaryImport_CreateSvodAvizo", ParamIn, ParamOut
                    
                    UbsFile.WriteLine vbNewLine & ParamOut.Parameter("strReport")
                    
                    If Not CBool(ParamOut.Parameter("bResult")) Then
                        ParamIn.Parameter("Идентификатор файла") = IdFile
                        ParamIn.Parameter("UndoOnImportError") = True
                        UbsChannel.Run "PCSalaryImport_Undo", ParamIn, ParamOut
                        bSetFileState = False
                        MsgBox "Ошибка создания сводного авизо по сводному платежу!" & vbNewLine & _
                            "Загрузка отменена.", vbCritical, "Ошибка"
                    End If
                End If
            End If
        
            UbsFile.CloseFile
            
            WaitBox.FileName = ClientFileName
            cmdExit.Caption = "Выход"
            cmdExit.Enabled = True
            Load.Caption = "Загрузка"
            Load.Enabled = True
            For c = 0 To lblChannelInfo().UBound
                lblChannelInfo(c).BackColor = Load.BackColor
            Next
      '      On Error Resume Next
            If bSetFileState Then SetFileStatus 0
       '     On Error GoTo 0
            WaitBox.MaximizeView
            WaitBox.ViewFile
            blnRespond = False
            Set WaitBox = Nothing
            
            UbsFile.DeleteFile ClientFileName
            ClientFileName = ""
            Timer1.Interval = 1000
            Timer1.Enabled = True
             'If IdFile > 0 And (chkControlRun.Value = vbChecked) Then
             '   ScriptRunner.Run "DeleteFileData", IdFile
           'End If
        End If
'  If CountResponce = CountResponceMax Then
 '    Timer1.Interval = 1000
 '    Timer1.Enabled = True
 ' End If
     
    
    
    
        Exit Sub
    End If

ErrorCode:
    ToolErr.UbsErrMsg "UbsChnlAsync_Respond", "ошибка выполнения"
End Sub

Private Sub UserDocument_Hide()
    If blnRespond Then
        Dim k

        For k = 0 To UbsChnlAsync.UBound()
            UbsChnlAsync(k).StopRun
        Next
     
        While blnRespond
            DoEvents
        Wend
     
    End If
     
    Set User = Nothing
    Set ToolPubs = Nothing
    Set ToolErr = Nothing
    Set ScriptRunner = Nothing
    Set objInterfaces = Nothing
    
    Set objInParam = Nothing
    Set UbsFile = Nothing
    Set ParamIn = Nothing
    Set ParamOut = Nothing
    
    If CallWindowClose = False Then
        Dim NeedRefreshGrid As Variant
        NeedRefreshGrid = NeedRefresh
        If NumCallWindow <> 0 Then
            If Parent.IsExistParam(NumCallWindow, "NeedRefreshGrid") Then
                Parent.ParamInfo(NumCallWindow, "NeedRefreshGrid") = NeedRefreshGrid
            End If
        End If
    End If
End Sub

Private Sub UserDocument_KeyPress(KeyAscii As Integer)
    Select Case (KeyAscii)
        Case 13                              'Enter
             KeyAscii = 0
             objInterfaces.NextCtrl        'SendKeys "{TAB}"
    Case 27                              'Esc
             KeyAscii = 0
            objInterfaces.PrevCtrl        'SendKeys "+{TAB}"
    End Select
End Sub

Private Sub UserDocument_Initialize()
    ReDim ArrParam(3)
    
    ArrParam(0) = "WaitShow"
    ArrParam(1) = "InitParamGrid"
    ArrParam(2) = "LoadFromMenu"
    ArrParam(3) = "RetFromGrid"

    lblProgress.Caption = ""
End Sub

Private Sub Initialize()
    NeedRefresh = False
    CallWindowClose = False
     
    Set ToolPubs = CreateObject("ToolPubs.Interfaces")
    Set ToolErr = CreateObject("ToolPubs.IUbsError")
    Set objInterfaces = CreateObject("ToolPubs.Interfaces")

    Set objInParam = CreateObject("Lib2.IUbsParam")
    Set UbsFile = CreateObject("Lib1.IUbsFile")
    
    Set objFormat = CreateObject("Lib3.IUbsFormat")
    Set objArray = CreateObject("Lib1.IUbsArray")
    
    Set ParamIn = CreateObject("Lib2.IUbsParam")
    Set ParamOut = CreateObject("Lib2.IUbsParam")
    
    UbsChannel.HostAddress = Parent.LoaderParamInfo(NumWin, "HostAddress")
    UbsChannel.UserGUID = Parent.LoaderParamInfo(NumWin, "GuidSession")
    UbsChannel.LoadResource = "VBS:UBS_VBS\PLCARD\OPENWAY\PCSalaryImport.vbs"
    UbsChannel.FormatParamIn = "XML"
    UbsChannel.FormatParamOut = "XML"
End Sub

