Attribute VB_Name = "PCFileZPIn"
Attribute VB_GlobalNameSpace = False
Attribute VB_Creatable = True
Attribute VB_PredeclaredId = False
Attribute VB_Exposed = True
Attribute VB_Ext_KEY = "VBD_Name" ,"UBS_VBD\PLCARD\PCFileZPIn.htm"
Attribute VB_Ext_KEY = "VBD_BuildName" ,"UBS_VBD\PLCARD\PCFileZPIn.htm"
Attribute VB_Ext_KEY = "VBD_Description" ,"Загрузка файла заработной платы"
Attribute VB_Ext_KEY = "VBD_Business" ,"Пластиковые карты"
Attribute VB_Ext_KEY = "VBD_InMenu" ,"1"
Option Explicit
Implements UBSChild
