Private Property Get UBSChild_IsExistParam(ByVal NameParam As String) As Boolean
  Dim ss As Variant
   UBSChild_IsExistParam = False
   For Each ss In ArrParam
     If ss = NameParam Then
      UBSChild_IsExistParam = True
      Exit For
     End If
   Next
End Property

Private Sub UBSChild_NotifyCloseWindow(ByVal NumWindow As Integer)
    If NumWindow = NumCallWindow Then
        CallWindowClose = True
        If FixMyWindow = False Then
            cmdExit_Click
        End If
    End If

    If NumWindow = NumChildWin Then
        NumChildWin = 0
    End If
End Sub

Private Sub UBSChild_NotifyFixWindow(ByVal NumWindow As Variant, ByVal FixState As Boolean)
  If NumWindow = NumWin Then
     FixMyWindow = FixState
   End If
End Sub

Private Property Let UBSChild_NumWindow(ByVal RHS As Integer)
  NumWin = RHS
End Property

Private Property Let UBSChild_ParamInfo(ByVal NameParam As String, ByVal RHS As Variant)
    On Error GoTo ErrorCode
   
    Select Case NameParam
        Case "LoadFromMenu"
            Initialize
            NumCallWindow = 0
            InitFile
            Parent.WindowDraw(NumWin) = True
            ToolPubs.NextCtrl
            ToolPubs.PrevCtrl
            PathFile.SetFocus
            Exit Property
        Case "InitParamForm"
            Initialize
            NumCallWindow = RHS(0)
            InitFile
            Parent.WindowDraw(NumWin) = True
            ToolPubs.NextCtrl
            ToolPubs.PrevCtrl
            PathFile.SetFocus
            Exit Property
        Case "RetFromGrid"
            If NumChildWin = RHS(0) Then
                If IsArray(RHS(1)) Then
                    ParamIn.Parameter("Сводный платеж.Идентификатор") = CLng(RHS(1)(0))
                    ParamIn.Parameter("Сводный платеж.Бизнес") = PaymentOrderTypeTmp
                    UbsChannel.Run "PCSalaryImport_ReadPaymOrder", ParamIn, ParamOut
                    
                    If CBool(ParamOut.Parameter("bResult")) Then
                        PaymentOrderId = CLng(RHS(1)(0))
                        PaymentOrderType = PaymentOrderTypeTmp
                        PaymentOrder.Text = ParamOut.Parameter("Сводный платеж.Описание")
                    Else
                        MsgBox ParamOut.Parameter("StrReport"), vbCritical, "Ошибка!"
                    End If
                End If
                
                Parent.CloseWindow NumChildWin
            End If
            Exit Property
        Case Else
            ToolErr.UbsErrRaise "UBSChild_ParamInfo", "Параметр " & NameParam & " не поддерживается"
    End Select

ErrorCode:
    ToolErr.UbsErrMsg "UBSChild_ParamInfo", "ошибка выполнения"
    Parent.CloseWindow NumWin
End Property

Private Property Get UBSChild_ParamInfo(ByVal NameParam As String) As Variant
  If NameParam = "WaitShow" Then
     UBSChild_ParamInfo = True
   End If
End Property

