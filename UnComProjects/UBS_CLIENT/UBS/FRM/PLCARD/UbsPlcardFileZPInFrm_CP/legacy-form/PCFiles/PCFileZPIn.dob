Dim lngRecordCounter As Long, lngRecordUp As Long

' Типы платежных поручений для обработки
Dim varTypePaymentOrder
Dim PaymentOrderId As Long
Dim PaymentOrderType As String, PaymentOrderTypeTmp As String
Dim ParamIn As Object, ParamOut As Object
Dim varDoc
Dim varGainType

Dim IdFile As Long


Private Sub Browse_Click()
  CommonDlg.CancelError = True
On Error GoTo ErrCode
  
  CommonDlg.InitDir = PathFile.Text
  CommonDlg.ShowOpen
  PathFile.Text = CommonDlg.FileName
  Exit Sub
  
ErrCode:
  Exit Sub
End Sub

Private Sub cmdExit_Click()
    On Error GoTo ErrorCode
    
    If blnRespond Then
        Dim x As Integer
        For x = 0 To UbsChnlAsync.UBound()
            UbsChnlAsync(x).StopRun
        Next
                  
        While blnRespond
            DoEvents
        Wend
    End If
  
    Parent.CloseWindow NumWin

    Exit Sub

ErrorCode:
    ToolErr.UbsErrMsg "cmdExit_Click", "ошибка выполнения"
End Sub

Private Sub cmdPaymentOrder_Click()
    Dim objGridList As Object
    Dim lngKey
    Dim templ As String
    Dim var, i
    
    On Error GoTo ErrorCode
    
    If NumChildWin <> 0 Then
        Parent.SetFocusToWindow NumChildWin
        Exit Sub
    End If
    
    PaymentOrderTypeTmp = ""
    frmPaymentOrder.Relult = vbCancel
    
    If frmPaymentOrder.ListPaymentOrder.ListCount = 0 Then
        If IsArray(varTypePaymentOrder) Then
            For i = 0 To UBound(varTypePaymentOrder, 2)
                frmPaymentOrder.ListPaymentOrder.AddItem varTypePaymentOrder(2, i)
                frmPaymentOrder.ListPaymentOrder.ItemData(frmPaymentOrder.ListPaymentOrder.NewIndex) = varTypePaymentOrder(0, i)
            Next
            frmPaymentOrder.ListPaymentOrder.ListIndex = 0
        End If
    End If
    
    frmPaymentOrder.Show vbModal, Me
    If frmPaymentOrder.Relult = vbCancel Then Exit Sub
    If frmPaymentOrder.ListPaymentOrder.ListIndex < 0 Then Exit Sub
    
    For i = 0 To UBound(varTypePaymentOrder, 2)
        If varTypePaymentOrder(0, i) = frmPaymentOrder.ListPaymentOrder.ItemData(frmPaymentOrder.ListPaymentOrder.ListIndex) Then
            PaymentOrderTypeTmp = varTypePaymentOrder(1, i)
            Exit For
        End If
    Next
    
    If PaymentOrderTypeTmp = "RC" Then _
        templ = "UBS_LIST_RC_PAYMENT_BASE_R"
    If PaymentOrderTypeTmp = "CLBANK" Then _
        templ = "UBS_LIST_CLBANK_DOCUMENT_RUB_FULL"
    
    Parent.GetWindow templ, NumChildWin
    
    If NumChildWin <> 0 Then
        Set objGridList = Parent.ParamInfo(NumChildWin, "UbsGridList")
        
        If PaymentOrderTypeTmp = "CLBANK" Then
            If DateIn.IsValid Then
                lngKey = objGridList.AddWhereItem("Дата создания", 1, DateIn.DateValue + 1)
                objGridList.WhereItemFlags(lngKey) = 1
            End If
            lngKey = objGridList.AddWhereItem("Счет получателя", 8, Array("00000000000000000000", ""))
            objGridList.WhereItemFlags(lngKey) = 1
            lngKey = objGridList.AddWhereItem("Ид. состояния обработки", 8, Array(4, 7))
            objGridList.WhereItemFlags(lngKey) = 1
        End If
        
        If PaymentOrderTypeTmp = "RC" Then
            If DateIn.IsValid Then
                lngKey = objGridList.AddWhereItem("Дата проведения платежа", 3, DateIn.DateValue)
                objGridList.WhereItemFlags(lngKey) = 1
            End If
            lngKey = objGridList.AddWhereItem("Л/с получателя", 8, Array("00000000000000000000", ""))
            objGridList.WhereItemFlags(lngKey) = 1
            'lngKey = objGridList.AddWhereItem("Стадия обработки", 4, 3)
            'objGridList.WhereItemFlags(lngKey) = 1
            lngKey = objGridList.AddWhereItem("Список стадий обработки", 8, Array("UBS_UNKNOWN", "UBS_REC_ERROR"))
            objGridList.WhereItemFlags(lngKey) = 1
        End If
      
        Dim InitParamGrid As Variant
        ReDim InitParamGrid(5)

        If Parent.IsExistParam(NumChildWin, "InitParamGrid") Then
            InitParamGrid(0) = NumWin
            InitParamGrid(2) = True
            InitParamGrid(5) = 2        ' Сразу на вкладку "Список"
            Parent.ParamInfo(NumChildWin, "InitParamGrid") = InitParamGrid
            Parent.SetFocusToWindow NumChildWin
        End If
    End If
    
    Exit Sub

ErrorCode:
    ToolErr.UbsErrMsg "cmdPaymentOrder_Click", "ошибка выполнения"
End Sub

Sub SetFileStatus(ByVal State As Long)
    ParamIn.Parameter("IdFile") = IdFile
    ParamIn.Parameter("State") = State
    Call UbsChannel.Run("PCPRCFile_SetStateParam", ParamIn, ParamOut)
End Sub

Private Sub Load_Click()
    Dim arrData
    Dim MaxTr
    Dim Tr
    Dim nThread, arrThread
    Dim FSO As Object
    
    
    On Error GoTo ErrorCode
  
    IdFile = 0
    varDoc = Empty
  
    If DateIn.DateValue = #1/1/2222# Then
        MsgBox "Не установлена дата загрузки", , "Ошибка"
        DateIn.SetFocus
        Exit Sub
    End If
    
    If RTrim(PathFile.Text) = "" Then
        MsgBox "Не установлено имя файла", , "Ошибка"
        PathFile.SetFocus
        Exit Sub
    End If
    
    Set FSO = CreateObject("ToolPubs.IUbsFile")
    If FSO.FileExists(PathFile.Text) = False Then
        MsgBox "Неверное имя или путь к файлу", , "Ошибка"
        PathFile.SetFocus
        Exit Sub
    End If
  
    UserDocument.MousePointer = 11
    
    varZPData = Empty
    
    lngRecordCounter = 0
    lngRecordUp = 0
    Call UbsChnlAsync_Notice(0, "OK: 0")
    
    
    
    ScriptRunner.ReadAction "UBS_PLCARD_SALARY_FILE_LOAD" '"UBS_VBS_PLCARD_FILEZP_IN_L"
    
    ' Закачка
    ScriptRunner.ClearParameters
    ScriptRunner.Parameter("DateIn") = DateIn.DateValue
    ScriptRunner.Parameter("FileIn") = PathFile.Text
    ScriptRunner.Parameter("SearchByAccount") = cmbFindCard.ItemData(cmbFindCard.ListIndex)
    ScriptRunner.Parameter("MultiThread") = True
    ScriptRunner.Parameter("lblProgress") = lblProgress
    'ScriptRunner.Parameter("SearchByAccount") = chkFindMode.Value
    ScriptRunner.Parameter("UbsUser") = User
    If PaymentOrderId > 0 Then
        ScriptRunner.Parameter("Сводный платеж.Идентификатор") = PaymentOrderId
        ScriptRunner.Parameter("Сводный платеж.Бизнес") = PaymentOrderType
    End If
    
    ScriptRunner.Run "Handle_FileIn"
    IdFile = CLng(ScriptRunner.Parameter("IdFile"))
    
    If Not CBool(ScriptRunner.Parameter("blnResult")) Then
        If IdFile > 0 Then
            ParamIn.Parameter("Идентификатор файла") = IdFile
            ParamIn.Parameter("UndoOnImportError") = True
            UbsChannel.Run "PCSalaryImport_Undo", ParamIn, ParamOut
        End If
        GoTo ExitCode
    End If
    
    If IdFile > 0 Then
        If PaymentOrderId > 0 Then
            ParamIn.Parameter("Идентификатор файла") = IdFile
            ParamIn.Parameter("Сводный платеж.Идентификатор") = PaymentOrderId
            ParamIn.Parameter("Сводный платеж.Бизнес") = PaymentOrderType
            UbsChannel.Run "PCSalaryImport_RegisterFileSourceParam", ParamIn, ParamOut
            'WaitBox.WriteLine = ParamOut.Parameter("strReport")
        End If
    End If
    
    SetFileStatus 1
    
    ' Обработка
    ScriptRunner.ClearParameters
    ScriptRunner.Run "PCSalaryImport_GetData", IdFile, arrData
    

    
    If IsArray(arrData) Then
        Load.Enabled = False
        cmdExit.Caption = "Отмена"
        
        lngRecordCounter = UBound(arrData, 2) + 1
        Call UbsChnlAsync_Notice(0, "OK: 0")
        
        SetFileStatus 255
        
        Call objArray.SplitArray(nCountChanel, arrData, arrThread)

        blnRespond = True
        CountResponce = 0
        CountResponceMax = UBound(arrThread) + 1
        For nThread = 0 To UBound(arrThread)
            If IsArray(arrThread(nThread)) Then
            
                objInParam.Parameter("arrData") = arrThread(nThread)
                objInParam.Parameter("intThread") = nThread
                objInParam.Parameter("datOper") = DateIn.DateValue
                objInParam.Parameter("Ид.файла") = IdFile
                objInParam.Parameter("blnControlRun") = CBool(chkControlRun.Value = vbChecked)
                If PaymentOrderId > 0 Then
                    objInParam.Parameter("Сводный платеж.Идентификатор") = PaymentOrderId
                    objInParam.Parameter("Сводный платеж.Бизнес") = PaymentOrderType
                End If
                
                objInParam.Parameter("Вид дохода") = ""
                If cmbGainType.ListIndex > -1 Then
                    If cmbGainType.ItemData(cmbGainType.ListIndex) >= 0 Then
                        objInParam.Parameter("Вид дохода") = Trim(varGainType(1, cmbGainType.ItemData(cmbGainType.ListIndex)))
                    End If
                End If

                objInParam.ClearParameter "ReportError"
            
                UbsChnlAsync(nThread).LoadResource = "VBS:UBS_VBS\PLCARD\OPENWAY\PCSalaryImport.vbs"

                UbsChnlAsync(nThread).Tag = "Активный"
                lblChannelInfo(nThread).BackColor = RGB(165, 80, 100)
         
                UbsChnlAsync(nThread).RunAsync "PCSalaryImport_ProcessData", objInParam
                
            End If
        Next
    Else
        Load.Enabled = True
        SetFileStatus 0
        MsgBox "Данных для обработки нет!", vbInformation, "Довыполнение операций по файлу"
    End If
    
   ' If IdFile > 0 And (chkControlRun.Value = vbChecked) Then
   '    ScriptRunner.Run "PCSalaryUnloadFile", IdFile
   ' End If
  '  On Error Resume Next
  '  If IdFile > 0 And (chkControlRun.Value = vbChecked) Then
   '     ScriptRunner.Run "DeleteFileData", IdFile
   ' End If
   ' On Error GoTo 0

    
    'если файл занесли в базу и контрольный запуск, то удаляем данные по файлу из базы
  
ExitCode:
    UserDocument.MousePointer = 0
    NeedRefresh = True
    Exit Sub

ErrorCode:
    UserDocument.MousePointer = 0
    UbsChannel.NumFrame = 0
    ToolErr.UbsErrMsg "Load_Click", "ошибка выполнения"
End Sub

Private Sub Timer1_Timer()
Timer1.Enabled = False
      '   MsgBox CountResponce & "zzz" & CountResponceMax
           If IdFile > 0 And (chkControlRun.Value = vbChecked) Then
                ScriptRunner.Run "DeleteFileData", IdFile
           End If
End Sub

